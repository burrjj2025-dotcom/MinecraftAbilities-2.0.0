<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Placeholder names: the duplicator script will replace these. -->
  <groupId>me.jjonlinux.minecraftabilities</groupId>
  <artifactId>minecraft-abilities</artifactId>
  <version>2.0.0</version>
  <packaging>jar</packaging>
  <name>MinecraftAbilities</name>

  <properties>
    <!-- Which Paper API to compile against. Compile against the OLDEST version you
         want to support: a plugin can only use API that exists in this version.
         Override from the command line to test, e.g.
           mvn package -Dpaper.api.version=1.21-R0.1-SNAPSHOT -->
    <paper.api.version>1.21.11-R0.1-SNAPSHOT</paper.api.version>

    <!-- Java version of the compiled plugin (class files). Paper 1.20.5 and newer need
         Java 21; older servers (1.18 - 1.20.4) run on Java 17, which would need 17 here.
         This only sets the output target. Maven itself can run on any newer JDK. -->
    <java.release>21</java.release>

    <maven.compiler.release>${java.release}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <repositories>
    <repository>
      <id>papermc</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
  </repositories>

  <dependencies>
    <!-- "provided": the server supplies the API at runtime, so it is not packed into the jar. -->
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>${paper.api.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Jar name: MinecraftAbilities-1.0.0.jar -->
    <finalName>${project.name}-${project.version}</finalName>

    <resources>
      <!-- plugin.yml gets ${project.version} filled in; other resources are copied untouched. -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>plugin.yml</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>plugin.yml</exclude>
        </excludes>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
      </plugin>
    </plugins>
  </build>
</project>
